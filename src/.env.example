# Cau hinh chung cho ca ba thiet bi: COM3, COM10 va COM11.
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Camera stream COM10.
CAMERA_HOSTNAME=sentinel-stream-cam
STREAM_PORT=81
CAMERA_STREAM_URL=http://CAMERA_IP:81/stream

# HiveMQ cua mach dieu khien COM11.
MQTT_SERVER=YOUR_CLUSTER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=YOUR_MQTT_USERNAME
MQTT_PASSWORD=YOUR_MQTT_PASSWORD
MQTT_UPLOAD_TOPIC=/board/upload/data
MQTT_COMMAND_TOPIC=/board/get/data

# SMTP gui email canh bao (vi du Gmail: smtp.gmail.com, port 465, secure true).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Supabase cua Node server. Khong dua secret key vao firmware/browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
