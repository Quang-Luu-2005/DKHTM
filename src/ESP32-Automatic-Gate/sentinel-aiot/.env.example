# Sentinel MQTT bridge. Keep real credentials in .env.local only.
MQTT_URL="mqtts://YOUR_CLUSTER.s1.eu.hivemq.cloud:8883"
MQTT_USERNAME="YOUR_SENTINEL_MQTT_USERNAME"
MQTT_PASSWORD="YOUR_SENTINEL_MQTT_PASSWORD"
MQTT_UPLOAD_TOPIC="/board/upload/data"
MQTT_COMMAND_TOPIC="/board/get/data"
SERVER_PORT="3001"

# Email notifications through SMTP. For Gmail, use an App Password, not your
# normal Google Account password. Leave these blank to disable notifications.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="YOUR_SENDER_EMAIL@gmail.com"
SMTP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"
SMTP_FROM="Sentinel Gate <YOUR_SENDER_EMAIL@gmail.com>"
