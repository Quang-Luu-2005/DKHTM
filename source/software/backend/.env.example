PORT=3001
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel?schema=public
DEVICE_SECRET=demo-secret
# LAN address printed by the ESP32-CAM. The backend calls /face/embedding here
# while enrolling an uploaded portrait.
CAMERA_URL=
CAMERA_TIMEOUT_MS=15000
# LAN address printed by the main controller after it connects to Wi-Fi.
CONTROLLER_URL=
CONTROLLER_DEVICE_ID=MAIN_CONTROLLER_001
DEFAULT_GATE_ID=GATE_01
# Optional when frontend and backend are hosted on different origins.
FRONTEND_ORIGIN=http://localhost:3000
COMMAND_TIMEOUT_MS=5000
COMMAND_MAX_ATTEMPTS=3
# Cosine similarity must meet this value and follow a recent PRESENCE_DETECTED
# event before Face ID can open the gate.
FACE_MATCH_THRESHOLD=0.55
FACE_PRESENCE_WINDOW_MS=5000
FACE_UPLOAD_MAX_BYTES=8388608
# Thời gian giữ cửa mở sau khi Face ID/RFID được chấp nhận.
ACCESS_UNLOCK_DURATION_MS=5000
# Thời gian bật đèn/còi cảnh báo cho một lần xác thực bị từ chối.
DENIED_SIGNAL_DURATION_MS=1000
DEVICE_OFFLINE_AFTER_MS=45000
UPLOAD_DIR=./uploads
